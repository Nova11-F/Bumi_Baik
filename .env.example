# .env.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set true only after enabling Google in Supabase Auth and adding the callback URL.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# SERVER ONLY — jangan diawali NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

PAYMENT_PROVIDER=mock            # mock | paymenku
PAYMENKU_BASE_URL=https://paymenku.com/api/v1
PAYMENKU_API_KEY=                # sk_test_... (jangan pernah sk_live_ saat pengembangan)
PAYMENKU_WEBHOOK_SECRET=

CRON_SECRET=
